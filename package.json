{
  "name": "adiutor",
  "version": "0.1.2",
  "private": true,
  "description": "Personal project-focus system: a morning board, a Telegram morning message and an MCP server for AI agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:sync && pnpm build:web",
    "build:server": "esbuild src/server/index.ts src/server/healthcheck.ts src/server/cli.ts --bundle --platform=node --target=node26 --format=esm --outdir=dist/server",
    "build:sync": "esbuild src/sync/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/sync/adiutor-sync.js",
    "build:web": "vite build --config config/vite.config.ts",
    "dev:web": "vite --config config/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:integration": "vitest run --config config/vitest.integration.config.ts",
    "lint": "biome ci .",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:skill": "node --test skill/test/contract.test.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.19",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hono/node-server": "2.1.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-query": "5.107.1",
    "better-auth": "1.7.19",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "lucide-react": "1.70.0",
    "postgres": "4.1.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
